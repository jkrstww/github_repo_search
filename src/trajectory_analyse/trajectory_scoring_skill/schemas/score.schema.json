{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["trajectory", "scores", "raw_total_score", "total_score", "evidence_confidence", "caps_or_flags", "facts", "oracle", "evidence_gaps", "key_strengths", "key_risks", "conclusion"],
  "properties": {
    "trajectory": {"type": "string"},
    "scores": {
      "type": "object",
      "required": ["A", "B", "C", "D", "E", "F"],
      "additionalProperties": false,
      "properties": {
        "A": {"$ref": "#/$defs/dimensionScore"},
        "B": {"$ref": "#/$defs/dimensionScore"},
        "C": {"$ref": "#/$defs/dimensionScore"},
        "D": {"$ref": "#/$defs/dimensionScore"},
        "E": {"$ref": "#/$defs/dimensionScore"},
        "F": {"$ref": "#/$defs/dimensionScore"}
      }
    },
    "raw_total_score": {"type": "number"},
    "total_score": {"type": "number"},
    "evidence_confidence": {"enum": ["high", "medium", "low"]},
    "caps_or_flags": {"type": "array", "items": {"type": "string"}},
    "facts": {"type": "object"},
    "oracle": {"type": "object"},
    "evidence_gaps": {"type": "array"},
    "key_strengths": {"type": "array"},
    "key_risks": {"type": "array"},
    "conclusion": {"type": "string"},
    "criterion_scores": {
      "type": "array",
      "description": "Optional A1-F3 sub-score audit trail.",
      "items": {
        "type": "object",
        "required": ["id", "score", "max_score"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-F][1-5]$"},
          "score": {"type": "number", "minimum": 0},
          "max_score": {"type": "number", "exclusiveMinimum": 0},
          "case_refs": {"type": "array", "items": {"type": "string"}},
          "evidence": {"type": "array"}
        },
        "additionalProperties": true
      }
    }
  },
  "$defs": {
    "dimensionScore": {
      "type": "object",
      "required": ["score"],
      "properties": {
        "name": {"type": "string"},
        "score": {"type": "number", "minimum": 0},
        "max_score": {"type": "number", "exclusiveMinimum": 0},
        "level": {"type": "string"},
        "evidence": {"type": "array"}
      },
      "additionalProperties": true
    }
  }
}
